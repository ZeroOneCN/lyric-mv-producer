# One source of truth for build.sh and engine/main.js.
# The 16:9 pixel engine outputs 1920x1080 by design; change the composition,
# not just these numbers, if you need another frame.
SLUG="my-lyric-mv"
TITLE="MY LYRIC MV"
SUBTITLE="A CODE-DRAWN LYRIC FILM"
SONG="song.mp3"
DUR="24.0"
FPS="24"
WIDTH="1920"
HEIGHT="1080"
POSTER_T="23.7"
# Covers are their own compositions on their own grids, never crops of the
# poster, and they always carry TITLE. 4:3 = 240x180 -> 1920x1440,
# 3:4 = 135x180 -> 1080x1440 (same pixel cell as the film, so sprites keep
# their relative size). Cover art is engine/main.js coverMotif(); the layout
# law (bottom type band, dithered plate, corner ticks) is engine/cover.js.
COVER_SHAPES="4x3,3x4"
# COVER_TYPE: band (picture stops above the title band) | overlay (picture bleeds,
# the title sits on a dithered plate over it)
COVER_TYPE="band"
COVER_DENS=""
COVER_ARTIST=""
COVER_TAGLINE=""
# Fixed lyric caption, drawn on a 2x overlay layer above the picture: one line,
# centred, anchored near the bottom. Geometry (640x360 layer, 560 px line,
# 1 line) lives in engine/px.js and is not configurable; only these three knobs are.
# SUB_STYLE: plate (dithered plate behind the line) | bubble (solid plate) | plain (outline only)
SUB_STYLE="plate"
SUB_DENS="0.45"
SUB_FADE="0.18"
# Character reference intake. The image stays working material; the sprite in
# engine/main.js is code-drawn from it. See tools/char_ref.py.
CHAR_REF=""
CHAR_SHEET=""
